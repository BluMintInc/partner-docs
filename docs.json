{
  "$schema": "https://mintlify.com/docs.json",
  "name": "BluMint game partner docs",
  "theme": "sequoia",
  "colors": { "primary": "#0066cc", "light": "#33ccff", "dark": "#0066cc" },
  "logo": { "light": "/logo/light.svg", "dark": "/logo/dark.svg", "href": "https://docs.blumint.com" },
  "favicon": "/favicon.svg",
  "appearance": { "default": "system" },
  "navbar": {
    "links": [{ "label": "Contact", "href": "https://app.blumint.com/contact" }],
    "primary": { "type": "button", "label": "Request an API key", "href": "https://app.blumint.com/contact/game-partner" }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guide",
        "groups": [
          { "group": "Get started", "pages": ["index", "before-you-start", "tournament-lifecycle"] },
          {
            "group": "Build your integration",
            "pages": [
              "guide/register-your-callbacks",
              "guide/create-a-lobby",
              "guide/close-a-lobby",
              "guide/report-what-happened",
              "guide/player-lookup"
            ]
          },
          { "group": "Help", "pages": ["support"] }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          { "group": "Overview", "pages": ["api-reference/introduction"] },
          { "group": "Endpoints", "openapi": { "source": "openapi.json", "directory": "api-reference" } }
        ]
      }
    ]
  },
  "api": { "playground": { "display": "interactive", "proxy": true }, "examples": { "languages": ["curl", "javascript", "python"] } },
  "redirects": [
    { "source": "/how-a-match-runs", "destination": "/tournament-lifecycle" },
    { "source": "/guide/join-links", "destination": "/guide/create-a-lobby" },
    { "source": "/guide/common-pitfalls", "destination": "/guide/report-what-happened" }
  ],
  "contextual": { "options": ["copy", "view", "download-spec", "claude", "chatgpt"] },
  "seo": {
    "metatags": {
      "canonical": "https://docs.blumint.com",
      "og:image": "https://docs.blumint.com/social-card.png",
      "twitter:image": "https://docs.blumint.com/social-card.png"
    }
  }
}
